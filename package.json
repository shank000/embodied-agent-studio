{
  "name": "embodied-agent-studio",
  "private": true,
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node tools/python.mjs -m uvicorn server.app:app --host 127.0.0.1 --port 8000",
    "test": "node tools/python.mjs -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:ui": "node --test tests/test_frontend_state.mjs tests/test_simulators_ui.mjs tests/test_environment_ui.mjs tests/test_benchmarks_ui.mjs tests/test_rounds_ui.mjs tests/test_harnesspai_ui.mjs tests/test_task_graph_ui.mjs tests/test_behavior_ui.mjs tests/test_agent_harness_ui.mjs",
    "test:launcher": "node --test tests/test_launcher.mjs"
  },
  "engines": {"node": ">=22.19.0"},
  "overrides": {
    "zod@4.4.3": "4.6.7",
    "@deepseek-ai/dsh@0.2.1-rc.5": {
      "zod": "4.6.7",
      "undici": "8.12.2",
      "@modelcontextprotocol/client": "2.3.0",
      "fflate": "0.8.3"
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.316",
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@openai/codex": "0.155.1",
    "marked": "17.0.5",
    "vite": "^7.1.0"
  }
}
